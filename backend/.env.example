# ============================================================================
# BACKEND ENVIRONMENT VARIABLES
# ============================================================================
# This file contains all required environment variables for the backend API.
# Copy this file to .env and fill in your actual credentials from:
# - Supabase: https://app.supabase.com/project/[PROJECT_ID]/settings/api
# - Stripe: https://dashboard.stripe.com/apikeys
# - Resend: https://resend.com/api-keys
# - AWS: https://console.aws.amazon.com/iam/
#
# IMPORTANT: Never commit the .env file with real credentials to git!
# ============================================================================

# ============================================================================
# SUPABASE CONFIGURATION (Required)
# ============================================================================
# Obtain these values from: Supabase Dashboard > Settings > API
# Project URL: https://app.supabase.com/project/[PROJECT_ID]/settings/general
# API Keys: https://app.supabase.com/project/[PROJECT_ID]/settings/api

# Supabase project URL (e.g., https://xxx.supabase.co)
# Found in: Settings > API > Project URL
SUPABASE_URL="https://your-project.supabase.co"

# Supabase Service Role Key (KEEP SECRET!)
# Found in: Settings > API > Service Role Key
# This key has full database access and should only be used on the server
SUPABASE_SERVICE_ROLE_KEY="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..."

# Supabase Anonymous Key (can be public)
# Found in: Settings > API > anon public key
# Used for client-side operations with Row Level Security
SUPABASE_ANON_KEY="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..."

# PostgreSQL connection string (for direct database access)
# Found in: Settings > Database > Connection string > Postgres URI
# Format: postgresql://[user]:[password]@[host]:[port]/[database]
DATABASE_URL="postgresql://postgres:password@db.your-project.supabase.co:5432/postgres?sslmode=require"

# ============================================================================
# APPLICATION CONFIGURATION (Required)
# ============================================================================

# Frontend application origin URL (for CORS and redirects)
# Development: http://localhost:5173
# Production: https://imaginethisprinted.com
APP_ORIGIN="http://localhost:5173"

# Backend API origin URL
# Development: http://localhost:4000
# Production: https://api.imaginethisprinted.com
API_ORIGIN="http://localhost:4000"

# Frontend URL (for email links, redirects, etc.)
# Should match APP_ORIGIN
FRONTEND_URL="http://localhost:5173"

# Comma-separated list of allowed CORS origins
# Allows requests from these domains
# Development: http://localhost:5173,http://localhost:4000
# Production: https://imaginethisprinted.com,https://api.imaginethisprinted.com
ALLOWED_ORIGINS="http://localhost:5173,http://localhost:4000"

# Node.js environment (development or production)
# Controls logging, error handling, and feature flags
NODE_ENV="development"

# API server port
# Development: 4000
# Production: configured via Railway/hosting platform
PORT="4000"

# ============================================================================
# AUTHENTICATION & SECURITY (Required)
# ============================================================================

# JWT Secret for signing tokens (minimum 32 characters)
# Generate a secure random string:
# On Linux/Mac: openssl rand -base64 32
# On Windows: Can use any secure random string generator
# MUST be at least 32 characters long for security
JWT_SECRET="your-jwt-secret-key-minimum-32-characters-long"

# ============================================================================
# PAYMENT PROCESSING - STRIPE (Optional but recommended)
# ============================================================================
# Obtain these from: https://dashboard.stripe.com/apikeys
# TEST KEYS (starts with pk_test_ / sk_test_) for development
# LIVE KEYS (starts with pk_live_ / sk_live_) for production

# Stripe publishable key (can be public)
# Used on frontend for Stripe integration
STRIPE_PUBLISHABLE_KEY="pk_test_..."

# Stripe secret key (KEEP SECRET!)
# Only used on backend for payment processing
STRIPE_SECRET_KEY="sk_test_..."

# Stripe webhook signing secret (KEEP SECRET!)
# Found in: Stripe Dashboard > Webhooks > Signing secret
# Used to verify webhook requests from Stripe
STRIPE_WEBHOOK_SECRET="whsec_..."

# Secret used to HMAC-sign short-lived carrier shipping quotes (POST
# /api/shipping/rates -> backend/services/shipping-quote.ts). Falls back to
# STRIPE_WEBHOOK_SECRET / SUPABASE_SERVICE_ROLE_KEY if unset, but set this
# explicitly in production — any 32+ char random string.
SHIPPING_QUOTE_SECRET=""

# Set to "true" to switch order tax calculation from the US state base-rate
# table (backend/services/order-pricing.ts US_STATE_BASE_SALES_TAX_RATES) to
# Stripe Tax. REQUIRES David to first configure tax registrations and
# per-product tax codes in the Stripe Dashboard — Stripe Tax returns $0 tax
# for any unregistered jurisdiction, so flipping this on before that
# configuration silently UNDER-collects tax. Leave unset/false until then.
STRIPE_TAX_ENABLED="false"

# ============================================================================
# EMAIL SERVICE - RESEND (the only transactional transport)
# ============================================================================
# Domain imaginethisprinted.com is verified in Resend. All transactional
# emails (welcome, order confirmation, support tickets, etc.) are sent via
# Resend. There is no fallback provider — if RESEND_API_KEY is absent at
# runtime, sends fail loudly (logged) rather than silently rerouting through
# a different, unmonitored provider.
#
# Sender identity (SPF/DKIM/DMARC) must be verified in the Resend dashboard
# for imaginethisprinted.com — see docs/ENV_VARIABLES.md for the DNS records.

# Resend API key (KEEP SECRET!)  — https://resend.com/api-keys
RESEND_API_KEY="re_xxxxxxxxxxxx"

# "From" address used for all outgoing transactional email.
# Must match a verified Resend domain.
EMAIL_FROM="Imagine This Printed <wecare@imaginethisprinted.com>"

# Required to trigger a REAL test send from GET /api/health/email (via header
# x-health-probe-token or ?token=). Without a valid token that endpoint only
# reports configuration presence and never calls Resend — keeps it from being
# an unauthenticated open spam relay. Generate a random 32+ character string.
HEALTH_PROBE_TOKEN="..."

# ============================================================================
# AWS S3 / FILE STORAGE (Optional but recommended)
# ============================================================================
# Obtain these from: AWS IAM > Users > Security credentials
# Used for storing product images, user uploads, etc.

# AWS access key ID
AWS_ACCESS_KEY_ID="AKIA..."

# AWS secret access key (KEEP SECRET!)
AWS_SECRET_ACCESS_KEY="..."

# AWS region for S3 bucket
# Examples: us-east-1, us-east-2, eu-west-1
AWS_REGION="us-east-1"

# AWS S3 bucket name for file storage
AWS_BUCKET_NAME="your-bucket-name"

# Alias for AWS_BUCKET_NAME (used in some parts of codebase)
S3_BUCKET_NAME="your-bucket-name"

# CloudFront distribution URL (CDN for S3 assets)
# Format: https://your-distribution-id.cloudfront.net
# Allows serving images with better performance and caching
CLOUDFRONT_URL="https://your-distribution.cloudfront.net"

# ============================================================================
# GOOGLE CLOUD STORAGE (Optional - alternate to S3)
# ============================================================================
# Used by image-flow services for signed-URL uploads (1-year expiry).
# Bucket name (e.g. imagine-this-printed-main)
GCS_BUCKET_NAME="your-bucket-name"

# Google Cloud project ID
GCS_PROJECT_ID="your-project-id"

# Path to service-account JSON file OR raw JSON string (KEEP SECRET!)
GCS_CREDENTIALS="/path/to/service-account.json"

# Public-asset bucket name (alias used in some services)
ASSET_BUCKET="your-bucket-name"

# Public URL prefix served from the bucket (used to build object URLs)
PUBLIC_URL="https://storage.googleapis.com/your-bucket-name"

# ---- Permanent media URLs (routes/media.ts) --------------------------------
# Public bucket access is blocked at the org level, so plain
# storage.googleapis.com URLs 403. Assets are therefore stored as
# <MEDIA_PROXY_ORIGIN>/api/media/<gcs-path>, which the API redirects to a
# freshly signed URL on every request — so nothing stored ever expires.
# Defaults to API_ORIGIN, then PUBLIC_URL, then the production API host.
MEDIA_PROXY_ORIGIN="https://api.imaginethisprinted.com"

# OPTIONAL fast path. As of 2026-07-26 this bucket answers plain
# https://storage.googleapis.com/<bucket>/<object> with HTTP 200 (uniform
# bucket-level access + a public read binding). Set this to
# "https://storage.googleapis.com/imagine-this-printed-main" and re-run
#   node scripts/backfill-design-library-media.mjs --force-urls
# to store direct CDN-cacheable URLs and skip the API hop entirely.
# OFF by default: that binding can't be verified from the app's service account,
# and if it is ever tightened every stored URL 403s again.
# MEDIA_PUBLIC_BASE="https://storage.googleapis.com/imagine-this-printed-main"

# Comma-separated GCS prefixes the media proxy may serve. Leave unset to use
# the built-in list (design-library/, design-sources/, graphics/, stock-models/,
# products/, mockups/). users/** is never proxied — those are private uploads.
# MEDIA_PROXY_PREFIXES="design-library/,design-sources/"

# ---- Design-library importer ------------------------------------------------
# Root of the local design bundle walked by scripts/import-designs.mjs
DESIGN_LIBRARY_ROOT="E:\\Business\\Imagine-This-Printed\\Imagine This Printed (Designs)"

# Skip uploading any single original source file larger than this (MB)
IMPORT_SOURCE_MAX_MB="300"

# ============================================================================
# AI / IMAGE GENERATION SERVICES (Optional)
# ============================================================================
# These power the AI design, mockup, edit, upscale, and 3D pipelines.

# OpenAI API key (KEEP SECRET!) - used for the AI assistants + GPT Image 2 edits
# https://platform.openai.com/api-keys
OPENAI_API_KEY="sk-..."

# gpt-4o / gpt-4o-mini / gpt-4 / gpt-4-turbo / gpt-3.5-turbo-0125 are retired
# (gpt-4 family hard shutdown 2026-10-23). Text + vision model IDs are now
# env-configurable across the backend AI services/routes:
OPENAI_TEXT_MODEL="gpt-5.4-nano"
OPENAI_VISION_MODEL="gpt-5.6-terra"
# Some features layer their own per-feature override on top (e.g.
# ETSY_SEO_MODEL, SEO_PACK_MODEL, DESIGN_ASSISTANT_MODEL) — see each
# service file for its specific env var.

# Replicate API token (KEEP SECRET!) - used for Recraft V4, Imagen 4, WAN, Nano Banana
# https://replicate.com/account/api-tokens
REPLICATE_API_TOKEN="r8_..."

# Replicate model IDs (override defaults if needed)
REPLICATE_PRODUCT_MODEL_ID="recraft-ai/recraft-v4"
REPLICATE_TRYON_MODEL_ID="cuuupid/idm-vton"

# fal.ai API key (KEEP SECRET!) - Tripo3D queue fallback only.
# image-flow no longer uses fal (all models purged 2026-07-27; see models.ts).
# https://fal.ai/dashboard/keys
FAL_API_KEY="..."

# OpenRouter API key (KEEP SECRET!) - used for Mr. Imagine (Gemini 2.5 Pro vision)
# https://openrouter.ai/keys
OPENROUTER_API_KEY="sk-or-..."

# Tripo3D Platform API key (KEEP SECRET!) - direct image-to-3D pipeline
# https://platform.tripo3d.ai/api-keys (Studio "tcli_*" keys will NOT work here)
TRIPO_API_KEY="tsk_..."

# remove.bg API key (KEEP SECRET!) - background removal fallback
# https://www.remove.bg/api
REMOVEBG_API_KEY="..."

# Hugging Face token (KEEP SECRET!) - used by select inference paths
# https://huggingface.co/settings/tokens
HF_TOKEN="hf_..."

# Webhook signing secret for AI job callbacks (KEEP SECRET!)
# Generate with: openssl rand -hex 32
AI_WEBHOOK_SECRET="random-32-byte-hex-string"

# ============================================================================
# THIRD-PARTY SEARCH / GOOGLE APIS (Optional)
# ============================================================================

# SerpAPI key (KEEP SECRET!) - used by trending product research
# https://serpapi.com/manage-api-key
SERPAPI_API_KEY="..."

# Google API key (KEEP SECRET!) - generic Google APIs (e.g. Search/Custom Search)
GOOGLE_API_KEY="AIza..."

# Google Maps API key (KEEP SECRET!) - shipping address autocomplete
# https://console.cloud.google.com/apis/credentials
GOOGLE_MAPS_API_KEY="AIza..."

# Shippo API token (KEEP SECRET!) - server-side carrier rate quoting for checkout
# https://apps.goshippo.com/settings/api
# Powers POST /api/shipping/rates (live USPS + UPS rates from the cart's real
# weight). LIVE rates also require USPS/UPS carrier accounts connected in the
# Shippo dashboard. If unset, the backend serves weight-aware USPS/UPS estimates.
SHIPPO_API_TOKEN="shippo_live_or_test_..."

# Print bridge: shared bearer the Watchtower print factory uses to call
# GET /api/print-bridge/queue and POST /api/print-bridge/status. Set the SAME
# value in Railway (ITP) and in Watchtower (.env.local).
PRINT_BRIDGE_TOKEN=replace-with-a-strong-shared-secret

# Storefront headless checkout: shared bearer for external storefronts (e.g.
# earth019.com) calling POST /api/storefront/checkout. Set the SAME value here and
# in the storefront's server env (earth019: ITP_STOREFRONT_KEY). Never expose to a
# browser. Also add the storefront's domain to ALLOWED_ORIGINS above.
STOREFRONT_API_KEY=replace-with-a-strong-shared-secret
STOREFRONT_SUCCESS_URL=https://earth019.com/checkout/success
STOREFRONT_CANCEL_URL=https://earth019.com/cart

# Per-tier cost basis for 3D-print catalog publishes through
# POST /api/storefront/products (a print3d lane, e.g. Darrell V2, sends
# garmentType='3d_print_<tier>'). Resolved dynamically the same way the
# apparel STOREFRONT_<GARMENT_TYPE>_BASE_COST_USD pattern works elsewhere in
# this file — no code branch needed, just set these once the cost basis is
# approved (Watchtower approval 8ffa97fe). Falls back to BASE_COST_USD when
# unset, so an unconfigured tier still 400s the sender's expectedCostUsd
# mismatch check rather than silently under-costing a product.
# Recommended values mirror ITP's own print prices (backend/services/tripo3d.ts
# SIZE_TIERS.printPriceUsd): mini 5.99 / small 11.99 / medium 18.99 / large 29.99.
STOREFRONT_3D_PRINT_MINI_BASE_COST_USD=
STOREFRONT_3D_PRINT_SMALL_BASE_COST_USD=
STOREFRONT_3D_PRINT_MEDIUM_BASE_COST_USD=
STOREFRONT_3D_PRINT_LARGE_BASE_COST_USD=

# Merch Studio sales-ledger webhook: ITP pushes signed order.paid /
# order.refunded / order.canceled events to Darrell V2
# (https://darrellmccutchen.com/api/merch/webhook, see its
# docs/merch-orders-webhook.md for the receiving contract) so its admin Shop
# page keeps a durable local sales history. MUST match the MERCH_WEBHOOK_SECRET
# value set in Darrell V2's Vercel env — inert (logs once, no-op) until set here.
MERCH_WEBHOOK_SECRET=replace-with-a-strong-shared-secret
# The ITP creator user id (uuid) whose products are Darrell's Merch Studio
# designs — same value as Darrell's creatorUserId entry in the
# STOREFRONT_CREATOR_KEYS JSON map (see backend/middleware/requireStorefrontSecret.ts;
# that var isn't in this template yet — set it directly in Render).
# This is the privacy gate: only order lines whose products.created_by_user_id
# matches this id are ever sent to Darrell V2, so no other creator's sales are
# ever transmitted. Also inert until set.
MERCH_WEBHOOK_CREATOR_USER_ID=

# In-app email system (Resend inbound/webhook)
EMAIL_DOMAIN=imaginethisprinted.com
RESEND_WEBHOOK_SECRET=whsec_xxxxxxxxxxxx

# Print-floor worker notifications (insert pause / ready for packing), comma-separated
PRINT_WORKER_EMAILS=worker1@imaginethisprinted.com,worker2@imaginethisprinted.com

# TikTok Shop integration (US Partner Center custom app)
# Get APP_KEY + APP_SECRET from partner.us.tiktokshop.com after the app is approved.
# WEBHOOK_SECRET comes from the webhook config in Partner Center (set later).
# Keep TIKTOK_ENABLED=false until the integration is built + tested in Sandbox.
TIKTOK_ENABLED=false
TIKTOK_REGION=US
TIKTOK_APP_KEY=
TIKTOK_APP_SECRET=
TIKTOK_WEBHOOK_SECRET=

# Etsy store integration (Open API v3, OAuth 2.0 PKCE — no client secret exists in v3)
# Create the app at https://www.etsy.com/developers/your-apps (same Etsy account
# as the ITP shop) and register BOTH redirect URIs on it:
#   http://localhost:3939/callback                              (PoC script)
#   https://api.imaginethisprinted.com/api/admin/etsy/callback  (production)
# Keep ETSY_ENABLED=false until the shop + app exist and the migration
# supabase/migrations/20260724_etsy_integration.sql has been applied.
# Full setup: docs/plans/2026-07-24-etsy-integration-plan.md
ETSY_ENABLED=false
ETSY_KEYSTRING=
# REQUIRED (Etsy v3 change, verified 2026-07-25): authenticated data calls send
# x-api-key: <ETSY_KEYSTRING>:<ETSY_SHARED_SECRET>. Keystring-alone → 403.
ETSY_SHARED_SECRET=
ETSY_REDIRECT_URI=https://api.imaginethisprinted.com/api/admin/etsy/callback
# ITP category slug -> Etsy taxonomy id (browse GET /api/admin/etsy/taxonomy?q=shirt)
# Only the PRIMARY tier reads this map; transfer/download carry their own ids below.
ETSY_TAXONOMY_MAP={"shirts":0,"hoodies":0,"tumblers":0,"dtf-transfers":0,"metal-art":0,"3d-prints":0}
ETSY_DEFAULT_TAXONOMY_ID=
# --- Selling tiers (backend/shared/etsy-tiers.ts) ---------------------------
# One design = up to three Etsy listings, because Etsy fixes `type` and
# `taxonomy_id` per listing. Defaults below are the live-verified nodes; leave
# them unless Etsy restructures its taxonomy.
#   6617 Craft Supplies & Tools > Canvas & Surfaces > Stencils, Templates & Transfers > Image Transfers
#   6844 …> Stencils, Templates & Transfers > Clip Art & Image Files
ETSY_TRANSFER_TAXONOMY_ID=6617
ETSY_DOWNLOAD_TAXONOMY_ID=6844
# ANCHOR prices. A standing 40% shop sale (Shop Manager — Etsy has no API for
# sale events) is what buyers actually pay, so these are the struck-through
# numbers: $5 -> $3 download, $12/$20/$28 -> $7.20/$12/$16.80 transfers.
ETSY_DOWNLOAD_PRICE=5
ETSY_TRANSFER_PRICE_8_5X11=12
ETSY_TRANSFER_PRICE_11X17=20
ETSY_TRANSFER_PRICE_13X19=28
# From GET /api/admin/etsy/shipping-profiles / /return-policies after connecting
ETSY_SHIPPING_PROFILE_ID=
ETSY_RETURN_POLICY_ID=
# REQUIRED on physical listings (Etsy change, verified 2026-07-25 — omitting it 400s). Provision once via
# POST /shops/{id}/readiness-state-definitions (readiness_state=made_to_order + min/max_processing_time), then read the id.
ETSY_READINESS_STATE_ID=
# Listings post as invisible free DRAFTS unless auto-publish is on ($0.20/listing when activated)
ETSY_AUTO_PUBLISH=false
ETSY_DEFAULT_QUANTITY=100

# --- Buyer-side virtual try-on (FASHN tryon-v1.6) --------------------------
# The whole feature is DARK until FASHN_API_KEY is set: the product-page card
# renders to null and /api/tryon/generate returns 503. Key comes from
# https://app.fashn.ai (Settings -> API). See docs/VIRTUAL_TRYON.md.
FASHN_API_KEY=
# Kill switch that works even with a key present.
TRYON_ENABLED=true
# What one FASHN credit costs us. 0.075 = on-demand; drop to 0.0488 on
# commitment tier III so the cost report in /api/tryon/analytics stays honest.
FASHN_COST_PER_CREDIT_USD=0.075
# Free try-ons per user per day. The brief caps this at 1 — raising it
# multiplies the giveaway cost linearly.
TRYON_DAILY_FREE=1
# Day boundary for that free grant (store-local, not UTC).
TRYON_TIMEZONE=America/New_York
# Per-user rate limit on /generate, on top of the daily free cap.
TRYON_LIMIT_PER_MIN=6
# Economics of the keep-or-kill verdict in /api/tryon/analytics.
TRYON_BREAKEVEN_USD=0.075
TRYON_VALUE_PER_ADD_TO_CART_USD=4
TRYON_MIN_SHOPPERS_FOR_VERDICT=50
# --- Photo retention sweep (worker service) --------------------------------
# Shopper photos are faces and bodies, so they expire on a timer whether or not
# anyone presses Delete. Runs in the WORKER, needs the worker's GCS creds, and
# declines to run without them. See docs/VIRTUAL_TRYON.md section 7.1.
# This number is also quoted to the shopper in the card's privacy copy.
TRYON_PHOTO_RETENTION_DAYS=30
# Sweep cadence in hours. Daily: the window is measured in weeks, so a faster
# tick only buys query load.
TRYON_RETENTION_SWEEP_HOURS=24
# true keeps the rendered results past the window and expires only the source
# photo. Default false — a result is the shopper's own body wearing the
# garment, so it is at least as identifying as the upload.
TRYON_RETENTION_KEEP_RESULTS=false
# Rows per tick, so a backlog drains over days instead of hanging the worker.
TRYON_RETENTION_BATCH=200
# Set to false to switch the sweep off entirely.
TRYON_RETENTION_ENABLED=true
