# ============================================================================
# FRONTEND ENVIRONMENT VARIABLES
# ============================================================================
# This file contains environment variables for the Vite frontend application.
# All variables must be prefixed with VITE_ to be accessible in the browser.
#
# Copy this file to .env and fill in your values from:
# - Supabase: https://app.supabase.com/project/[PROJECT_ID]/settings/api
# - Stripe: https://dashboard.stripe.com/apikeys
#
# IMPORTANT: This file is public and will be visible in the browser!
# Never include secret keys here (only publishable keys like Stripe pk_test_)
# ============================================================================

# ============================================================================
# SUPABASE CONFIGURATION (Required)
# ============================================================================
# Obtain these values from: Supabase Dashboard > Settings > API
# These keys are public and safe to expose in the frontend

# Supabase project URL (e.g., https://xxx.supabase.co)
# Found in: Settings > API > Project URL
VITE_SUPABASE_URL="https://czzyrmizvjqlifcivrhn.supabase.co"

# Supabase anonymous/public key (safe to expose)
# Found in: Settings > API > anon public key
# Used for client-side authentication and database queries with RLS
VITE_SUPABASE_ANON_KEY="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..."

# ============================================================================
# AUTHENTICATION CONFIGURATION (Optional)
# ============================================================================
# Control which authentication methods are enabled in the application
# Set to 'true' to enable, 'false' to disable

# Enable Google OAuth sign-in
# Requires Google OAuth client ID and secret configured in Supabase Dashboard
# Default: false (disabled for production stability)
VITE_ENABLE_GOOGLE_OAUTH="false"

# Enable Magic Link (passwordless) sign-in via email
# Requires Email Auth enabled in Supabase Dashboard
# Default: true
VITE_ENABLE_MAGIC_LINK="true"

# Enable Kiosk Mode (in-store point-of-sale terminal at /kiosk/:kioskId).
# Requires a kiosk row + at least one provisioned device secret — see
# backend/routes/admin/kiosk-devices.ts. Leave unset/false unless a kiosk
# is actually deployed: a disabled kiosk route is the cheapest possible
# fix for the attack surface it otherwise exposes.
# Default: false (disabled)
VITE_KIOSK_ENABLED="false"

# ============================================================================
# API CONFIGURATION (Required)
# ============================================================================

# Backend API base URL
# Development: http://localhost:4000
# Production: https://api.imaginethisprinted.com
VITE_API_BASE="http://localhost:4000"

# Frontend application URL (for redirects, emails, etc.)
# Development: http://localhost:5173
# Production: https://imaginethisprinted.com
VITE_SITE_URL="http://localhost:5173"

# Public URL for email redirects (password reset, magic links)
# Should match VITE_SITE_URL in most cases
# Production: https://imaginethisprinted.com
VITE_PUBLIC_URL="http://localhost:5173"

# ============================================================================
# PAYMENT PROCESSING - STRIPE (Optional)
# ============================================================================
# Only the publishable key should be here (pk_test_ or pk_live_)
# The secret key must NEVER be in frontend code - keep it in backend/.env

# Stripe publishable key (safe to expose)
# Found in: Stripe Dashboard > Developers > API keys > Publishable key
# Use pk_test_ for development, pk_live_ for production
VITE_STRIPE_PUBLISHABLE_KEY="pk_live_51P9r1WEkHNKUzCxORpaGdWHRglr8WVT5LyXmOz4pyubpk7WM1T31h6ge36PWMYWZ6cy0Yuvxn3pp7Ym2YBVFYIUr00UABlEsP9"

# ============================================================================
# SHIPPING - SHIPPO (Optional)
# ============================================================================

# Shippo API token used by the admin Order Management "Generate Label" flow.
# WHEN UNSET the app runs in MOCK mode: it returns a fake tracking number
# (MOCK123456789) and a fake label URL, nothing is purchased, and nothing ships.
# Mock mode is announced with a console warning and an amber banner on
# /order-management so a fake tracking number is never mistaken for a real one.
# NOTE: anything VITE_-prefixed is visible in the browser bundle. Carrier RATES
# are already quoted server-side (backend SHIPPO_API_TOKEN, backend/.env);
# moving label purchase to the backend too is tracked as follow-up work.
VITE_SHIPPO_API_TOKEN=""

# ----------------------------------------------------------------------------
# Ship-from (origin) address for purchased labels.
# ----------------------------------------------------------------------------
# All optional — each field falls back to the real Rockmart, GA warehouse
# (see src/config/ship-from.ts, defaults derived from WAREHOUSE_ADDRESS in
# src/utils/shipping-calculator.ts so labels and rate quotes share one origin).
# Set these to move the warehouse without a code change.
VITE_SHIP_FROM_NAME="Imagine This Printed"
VITE_SHIP_FROM_COMPANY="Imagine This Printed LLC"
VITE_SHIP_FROM_STREET1="640 Goodyear Ave"
VITE_SHIP_FROM_STREET2=""
VITE_SHIP_FROM_CITY="Rockmart"
VITE_SHIP_FROM_STATE="GA"
VITE_SHIP_FROM_ZIP="30153"
VITE_SHIP_FROM_COUNTRY="US"
# Some carrier services reject a label with a bogus origin phone — set a real one.
VITE_SHIP_FROM_PHONE="(770) 000-0000"
VITE_SHIP_FROM_EMAIL="shipping@imaginethisprinted.com"

# ============================================================================
# WALLET & CRYPTOCURRENCY CONFIGURATION (Optional)
# ============================================================================

# ITC (Imagine This Coin) wallet address
# This is the wallet address that receives cryptocurrency payments
# Get this from your cryptocurrency exchange/wallet setup
VITE_ITC_WALLET_ADDRESS="3XyoLPb3aek3poicnYXjrtMU6PUynRb93Q71FULKZ3Q"

# ITC to USD conversion rate
# Used for displaying prices to users
# Example: 0.10 means 1 ITC = $0.10 USD
VITE_ITC_USD_RATE="0.10"

# ============================================================================
# BRANDING ASSETS (Required)
# ============================================================================
# Logo paths for theme-aware branding
# These logos are swapped based on light/dark mode

# Dark logo (PNG) - displayed in light mode for contrast
# Path is relative to /public directory
VITE_LOGO_DARK="/assets/branding/itp-logo-dark.png"

# Light logo (SVG) - displayed in dark mode for contrast
# Path is relative to /public directory
VITE_LOGO_LIGHT="/assets/branding/itp-logo-light.svg"

# ============================================================================
# IMPORTANT SECURITY NOTES
# ============================================================================
# 1. ALL VITE_ variables are exposed in the browser (visible in source code)
# 2. Never put secret keys here (API secrets, database passwords, etc.)
# 3. Use environment-specific .env files:
#    - .env.local (local machine, not committed)
#    - .env.development (development environment)
#    - .env.production (production environment)
#
# Backend secrets (DATABASE_URL, STRIPE_SECRET_KEY, AWS credentials, etc.)
# are configured separately:
# - Local development: in backend/.env
# - Production: in Railway dashboard or hosting platform environment variables
