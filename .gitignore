.pytest_cache/

# Generated print-factory artifacts. The example SPECS are committed; the meshes
# and measurements they produce are not - they are reproducible in ~0.5s each
# via prep.py and a stale committed binary is worse than no binary.
tools/print-factory/examples/*.stl
tools/print-factory/examples/*.metrics.json
# The source shell GLBs are generative artifacts (2.3MB+ binaries) fetched
# from the image/3D pipeline, not source. prep.py takes a path to one.
tools/print-factory/examples/*.glb
