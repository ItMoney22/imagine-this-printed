# Frontend Environment Variables (Vite requires VITE_ prefix)
# Copy this to .env.local and fill in your actual values

# Supabase
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your_anon_key_here

# API Configuration
VITE_API_BASE=http://localhost:4000

# Stripe
VITE_STRIPE_PUBLISHABLE_KEY=pk_test_your_key_here

# Site URL
VITE_SITE_URL=http://localhost:5173

# Shippo (optional) — unset means MOCK labels: fake tracking, nothing ships.
# The admin Order Management page shows an amber banner while mocked.
VITE_SHIPPO_API_TOKEN=

# Ship-from origin for purchased labels (optional — defaults to the Rockmart, GA
# warehouse in src/config/ship-from.ts). See .env.example for the full list.
VITE_SHIP_FROM_STREET1=
VITE_SHIP_FROM_CITY=
VITE_SHIP_FROM_STATE=
VITE_SHIP_FROM_ZIP=
VITE_SHIP_FROM_PHONE=

# Cloudflare Turnstile — bot challenge on signup / sign-in / reset / magic link.
# PUBLIC site key only. The SECRET key belongs in the Supabase dashboard
# (Authentication -> Attack Protection) and nowhere else.
# Unset = no widget, forms behave exactly as before.
# Cloudflare test keys: 1x00000000000000000000AA always passes,
# 2x00000000000000000000AB always blocks. See docs/SIGNUP_BOT_PROTECTION.md.
VITE_TURNSTILE_SITE_KEY=
